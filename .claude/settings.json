{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__maestro__run",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/open-maestro-viewer.sh", "timeout": 5 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR\"/scripts/lib/kb-client.js --handshake", "timeout": 5 }
        ]
      }
    ]
  }
}
