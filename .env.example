# ── App Package Names ─────────────────────────────────────────────────────────
# The apps must be pre-installed on the connected device.
# Run `adb shell pm list packages` to find the correct package names.
CLASSIC_PACKAGE_NAME=com.example.member.classic
AI_PACKAGE_NAME=com.example.member.ai

# ── Device ───────────────────────────────────────────────────────────────────
# Run `adb devices` to find the device ID.
# Leave empty to use the first connected device.
MAESTRO_DEVICE_ID=

# ── Account Passwords ─────────────────────────────────────────────────────────
# Passwords for accounts defined in config/accounts.json.
# Key convention: ACCOUNT_<ID_UPPERCASE>_PASS
# Emails live in accounts.json (non-secret). Only passwords go here.
# Add one entry per account ID. Example:
ACCOUNT_CLASSIC_POST_LOGIN_PASS=TestPassword123
ACCOUNT_AI_3WC_NECK_FRESH_PASS=TestPassword123
ACCOUNT_AI_3WC_BACK_OLDER_PASS=TestPassword123
# Add more as needed: ACCOUNT_<ID_UPPERCASE>_PASS=...

# ── AI Vision ────────────────────────────────────────────────────────────────
# ⚠ SESSION_SKIP_SELECTOR and EXERCISE_SKIP_SELECTOR cannot be populated —
# the session UI is pure Compose with no resource-ids.
# See docs/session_missing_resource_ids.md for the dev task.
SESSION_SKIP_SELECTOR=
EXERCISE_SKIP_SELECTOR=

# ── Emulator / Video Tracking ────────────────────────────────────────────────
# Used by scripts/start-virtual-camera.sh and session_video_tracking.yaml.
# Requires Android Emulator ≥ 30.0 with videoplayback camera mode support.
EMULATOR_AVD=Pixel_5
EMULATOR_PORT=5554
VIDEO_PLACEMENT_TIMEOUT_MS=30000
VIDEO_SESSION_TIMEOUT_MS=150000

# ── Jira ─────────────────────────────────────────────────────────────────────
JIRA_BASE_URL=https://yourorg.atlassian.net
JIRA_PROJECT_KEY=MOB
JIRA_DASHBOARD_ISSUE_KEY=MOB-123
JIRA_USER_EMAIL=you@yourorg.com
JIRA_API_TOKEN=your_jira_api_token_here

# ── Figma Design Audit ────────────────────────────────────────────────────────
# Personal access token for the Figma REST API.
# Get one at: https://www.figma.com/settings → Account → Personal access tokens
# Used by: node scripts/save-figma-screenshots.js --figma-url=<url>
FIGMA_TOKEN=

ACCOUNT_AI_3WC_AUTORELEASE_ANDROID_PASS= 
ACCOUNT_CLASSIC_CV_AUTORELEASE_ANDROID_PASS= 
ACCOUNT_CLASSIC_DT_AUTORELEASE_ANDROID_PASS=
ANTHROPIC_API_KEY= 
GITHUB_TOKEN= 
GITHUB_ORG= 
KB_THRIVE_PM_PATH= 
DASHBOARD_PORT= 
ADB_PATH, REPORT_OUT=

# -- Wiki
WIKI_API_KEY=
